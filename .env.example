# Copy to .env.local in the repository root for local development.
# In GitHub Actions the deployment workflow supplies VITE_ICE_SERVERS.
# Use client TURN username/password issued for this application.
# NEVER put a provider administration API key here. VITE_ values are included
# in the public browser build; client TURN credentials must be usable by browsers.
# Use only the addresses, transports and credentials supplied by your provider.
VITE_ICE_SERVERS='[{"urls":["turns:turn.example.com:443?transport=tcp"],"username":"YOUR_TURN_USERNAME","credential":"YOUR_TURN_CLIENT_PASSWORD"}]'
